# .envrc

# 1. Ensure pyenv is installed and initialized
if ! command -v pyenv &> /dev/null; then
    echo "📦 pyenv not found. Installing via Homebrew..."
    brew install pyenv
fi

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# 2. Define and install the specific Python version
PYTHON_VERSION="3.13.0"
if ! pyenv versions --bare | grep -q "^${PYTHON_VERSION}"; then
    echo "🐍 Python ${PYTHON_VERSION} not found. Installing..."
    pyenv install ${PYTHON_VERSION}
fi

# 3. Setup the direnv-managed virtual environment
layout python $(pyenv prefix ${PYTHON_VERSION})/bin/python

# 4. Sync VS Code settings
ACTUAL_PYTHON_PATH=$(which python)
VSCODE_SETTINGS=".vscode/settings.json"

if [ ! -f "$VSCODE_SETTINGS" ] || ! grep -q "$ACTUAL_PYTHON_PATH" "$VSCODE_SETTINGS"; then
    echo "⚙️  Updating VS Code interpreter configuration..."
    mkdir -p .vscode
    export ACTUAL_PYTHON_PATH
    python -c "
import json, os
path = '$VSCODE_SETTINGS'
binary = os.environ['ACTUAL_PYTHON_PATH']
new_vals = {
    'python.defaultInterpreterPath': binary,
    'python.terminal.activateEnvInCurrentTerminal': True
}
data = json.load(open(path)) if os.path.exists(path) else {}
data.update(new_vals)
with open(path, 'w') as f:
    json.dump(data, f, indent=4)
"
fi

# 5. Automatically install requirements if they change
watch_file requirements.txt
TIMESTAMP_FILE="$(dirname $(dirname $ACTUAL_PYTHON_PATH))/requirements.timestamp"

if [ requirements.txt -nt "$TIMESTAMP_FILE" ]; then
    echo "📦 requirements.txt changed. Updating environment..."
    pip install -r requirements.txt
    touch "$TIMESTAMP_FILE"
fi

# 6. Final exports
export VIRTUAL_ENV=$(dirname $(dirname $ACTUAL_PYTHON_PATH))
